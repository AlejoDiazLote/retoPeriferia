# Clave del proveedor LLM (solo backend, nunca en el front ni en el repo)
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-opus-5; claude-sonnet-5 es la opción económica
ANTHROPIC_MODEL=
# Puerto HTTP (Railway lo inyecta)
PORT=3000
# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=90000
# Límite de turnos por IP cada 10 minutos
RATE_LIMIT_TURNOS=30
# Opcional: si se define, el front pide esta clave para usar el chat
ACCESS_KEY=
